# Кабинеты (partner / client / admin / cashier): Vite SPA за nginx. Контекст сборки — корень монорепо.
FROM node:22-alpine AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /repo

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm fetch

FROM deps AS build
ARG APP
# Адрес API попадает в бандл на этапе сборки
ARG VITE_API_URL
ARG VITE_SITE_URL
ARG VITE_CLIENT_APP_URL
ARG VITE_PARTNER_APP_URL
ARG VITE_CASHIER_APP_URL
# Web client ID Google для входа сотрудников; пусто — кнопки Google нет
ARG VITE_GOOGLE_CLIENT_ID
ENV VITE_API_URL=$VITE_API_URL VITE_SITE_URL=$VITE_SITE_URL VITE_CLIENT_APP_URL=$VITE_CLIENT_APP_URL \
    VITE_PARTNER_APP_URL=$VITE_PARTNER_APP_URL VITE_CASHIER_APP_URL=$VITE_CASHIER_APP_URL \
    VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID
COPY . .
RUN pnpm install --frozen-lockfile --offline
# Только сборка: проверка типов уже прошла локально и в pnpm typecheck,
# а внутри образа она удваивает время без пользы
RUN pnpm --filter @loal/$APP exec vite build

FROM nginx:1.27-alpine AS runtime
ARG APP
COPY infra/nginx/spa.conf /etc/nginx/conf.d/default.conf
COPY --from=build /repo/apps/$APP/dist /usr/share/nginx/html
EXPOSE 80
