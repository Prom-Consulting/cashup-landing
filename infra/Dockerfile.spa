# Кабинеты (partner / client / admin): Vite SPA за nginx. Контекст сборки — корень монорепо.
FROM node:22-alpine AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /repo

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm fetch

FROM deps AS build
ARG APP
# Адрес API попадает в бандл на этапе сборки
ARG VITE_API_URL
ARG VITE_SITE_URL
ENV VITE_API_URL=$VITE_API_URL VITE_SITE_URL=$VITE_SITE_URL
COPY . .
RUN pnpm install --frozen-lockfile --offline
RUN pnpm --filter @loal/$APP build

FROM nginx:1.27-alpine AS runtime
ARG APP
COPY infra/nginx/spa.conf /etc/nginx/conf.d/default.conf
COPY --from=build /repo/apps/$APP/dist /usr/share/nginx/html
EXPOSE 80
