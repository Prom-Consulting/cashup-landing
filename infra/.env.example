# Домены фронтендов (A-записи уже смотрят на сервер)
LANDING_HOST=loal.kg
ADMIN_HOST=admin.loal.kg
PARTNER_HOST=partner.loal.kg
CLIENT_HOST=client.loal.kg
CASHIER_HOST=cashier.loal.kg

# Адрес шлюза API. Попадает в бандлы кабинетов на этапе сборки образа.
API_URL=https://loal.promconsult.pro

# Docker-сеть, к которой подключён Traefik из cashup_platform.
# Проверить: docker inspect traefik -f '{{range $n,$_ := .NetworkSettings.Networks}}{{$n}}{{end}}'
TRAEFIK_NETWORK=infra_default

# Internal gateway URL for the shared 100 requests/sec, 15-minute IP ban.
# Deploy the updated cashup_platform gateway before enabling frontend protection.
# This must be an internal Docker URL, never the public site/API (no proxy loop).
GATEWAY_RATE_LIMIT_URL=http://gateway:8080/_edge/rate-limit
