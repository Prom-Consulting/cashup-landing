# Лендинг loal.kg: Next.js в standalone-режиме. Контекст сборки — корень монорепо.
FROM node:22-alpine AS base
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /repo

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm fetch

FROM deps AS build
# Сборка Next — самая тяжёлая часть. Потолок кучи держит её в рамках: на небольшом
# сервере иначе процесс убивает система (SIGKILL во время "Creating an optimized build").
ENV NODE_OPTIONS=--max-old-space-size=2048
ENV NEXT_TELEMETRY_DISABLED=1
COPY . .
RUN pnpm install --frozen-lockfile --offline
RUN pnpm --filter @loal/landing build

FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0
COPY --from=build /repo/apps/landing/.next/standalone ./
# server.js не копирует статику и public сам — переносим рядом
COPY --from=build /repo/apps/landing/.next/static ./apps/landing/.next/static
COPY --from=build /repo/apps/landing/public ./apps/landing/public
USER node
EXPOSE 3000
CMD ["node", "apps/landing/server.js"]
