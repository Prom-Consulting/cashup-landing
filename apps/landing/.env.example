# По умолчанию карта партнёров рисуется на тайлах OpenStreetMap.
# Переключить на 2GIS (ключ уже зашит в код):
NEXT_PUBLIC_MAP=
# Боевой ключ 2GIS вместо зашитого. В Platform Manager у ключа должны быть разрешены домены сайта,
# иначе 2GIS рисует поверх карты надпись «key is invalid».
NEXT_PUBLIC_2GIS_KEY=
# Необязательно: id стиля из редактора стилей 2GIS (https://styles.2gis.com) — фирменные цвета карты.
NEXT_PUBLIC_2GIS_STYLE=
